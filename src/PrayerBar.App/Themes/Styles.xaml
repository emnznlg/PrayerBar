<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Surface" Color="#151C29"/><SolidColorBrush x:Key="Text" Color="#F2F4F8"/><SolidColorBrush x:Key="Muted" Color="#A8B2C3"/><SolidColorBrush x:Key="Gold" Color="#E8C77F"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#E8C77F"/><Setter Property="Foreground" Value="#151C29"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,0,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,3,0,10"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="Margin" Value="0,18,0,8"/></Style>
</ResourceDictionary>
