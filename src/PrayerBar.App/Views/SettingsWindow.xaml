<Window x:Class="PrayerBar.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PrayerBar · Settings" Width="490" Height="720" MinWidth="420" MinHeight="400" Background="{StaticResource Surface}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24"><StackPanel DockPanel.Dock="Top"><TextBlock Text="PrayerBar" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="A quiet reminder, wherever your day takes you." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Error" Foreground="#FFAD91" TextWrapping="Wrap" Margin="0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel"/><Button x:Name="SaveButton" Content="Save settings" Click="Save"/></StackPanel></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">
      <TextBlock Text="General" Style="{StaticResource Section}"/><TextBlock Text="Prayer names"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Draft.Language}"/>
      <CheckBox Content="Start with Windows" IsChecked="{Binding Draft.StartWithWindows}"/><CheckBox Content="Launch minimized to tray" IsChecked="{Binding Draft.LaunchMinimized}"/>
      <TextBlock Text="Location &amp; calculation" Style="{StaticResource Section}"/><TextBlock Text="City"/><TextBox Text="{Binding Draft.City, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Country"/><TextBox Text="{Binding Draft.Country, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="IANA or Windows time zone ID"/><TextBox Text="{Binding Draft.TimeZoneId, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="AlAdhan calculation method"/><ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Draft.Method}"/><TextBlock Text="Asr jurisprudence"/><ComboBox ItemsSource="{Binding Schools}" SelectedItem="{Binding Draft.School}"/>
      <TextBlock Text="AlAdhan calculates these times. Method 13 is Diyanet; it is not a guarantee of the official published schedule." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="Widget" Style="{StaticResource Section}"/><CheckBox Content="Always on top" IsChecked="{Binding Draft.AlwaysOnTop}"/><CheckBox Content="Hide automatically during fullscreen" IsChecked="{Binding Draft.AutoHideFullscreen}"/><CheckBox Content="Hide for fullscreen on any monitor" IsChecked="{Binding Draft.GlobalFullscreenHide}"/><CheckBox Content="Show countdown seconds" IsChecked="{Binding Draft.ShowSeconds}"/>
      <TextBlock Text="Opacity" Margin="0,8,0,2"/><Slider Minimum="0.35" Maximum="1" Value="{Binding Draft.Opacity}" TickFrequency="0.05"/>
      <TextBlock Text="Size" Margin="0,8,0,2"/><Slider Minimum="0.8" Maximum="1.8" Value="{Binding Draft.Scale}" TickFrequency="0.1"/>
      <TextBlock Text="Appearance" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Appearances}" SelectedItem="{Binding Draft.Appearance}"/><CheckBox Content="Reset widget position when saving" IsChecked="{Binding ResetPosition}"/>
      <TextBlock Text="Notifications" Style="{StaticResource Section}"/><CheckBox Content="Notify when prayer time begins" IsChecked="{Binding Draft.Notifications}"/><TextBlock Text="Advance reminder (minutes; 0 disables)"/><ComboBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding Draft.ReminderMinutes}"/><CheckBox Content="Suppress notifications during fullscreen" IsChecked="{Binding Draft.SuppressFullscreenNotifications}"/>
      <TextBlock Text="Ctrl + Alt + P toggles the widget. Left-click opens today's times; drag to reposition. Windows notification settings may silence reminders." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,16"/>
    </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
